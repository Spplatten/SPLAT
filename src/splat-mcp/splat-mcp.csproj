<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SplatMcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Distribution is one self-contained single file, produced by packaging/publish-splat-mcp.ps1.

    NOT a `dotnet tool`, and not by preference: `PackAsTool` refuses a platform TFM outright -
    NETSDK1146, "PackAsTool does not support TargetPlatformIdentifier being set" - and this project
    must target net10.0-windows because it references MissionController.Infrastructure.Windows for
    the job object, the restricted token and the ACL jail. Shipping a tool package would mean a
    second, platform-neutral wrapper project carrying the real executable as payload; that is a
    moving part P1 does not need, since the single file already requires nothing of the machine.

    The native SQLite the ledger uses is a loose DLL beside the exe unless it is packed inside, and a
    "single file" that needs a file next to it is not one - so IncludeNativeLibrariesForSelfExtract
    stays on, and a test holds this file to it.
  -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!--
    The suite holds one thing this executable does not expose: the wsl.exe probe's budget is a
    budget, so exceeding it has to come back as a report rather than an exception. Visible to the
    tests rather than made public, because nothing outside this repository references this project.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="MissionController.Tests" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionController.Core\MissionController.Core.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Linux\MissionController.Infrastructure.Linux.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Data\MissionController.Infrastructure.Data.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Network\MissionController.Infrastructure.Network.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Windows\MissionController.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <!--
    The Linux daemon `splat-mcp provision` installs, carried inside the executable so a stranger needs
    neither this repository nor a Rust toolchain (roadmap 1.9). packaging/publish-splat-mcp.ps1 builds it
    in WSL and passes its path as SplatAgentBinary; an ordinary build passes nothing, embeds nothing, and
    provision builds from the repository with cargo instead. Carried inside rather than shipped beside it,
    so the executable and the daemon it installs cannot come from different builds.
  -->
  <ItemGroup Condition="'$(SplatAgentBinary)' != ''">
    <EmbeddedResource Include="$(SplatAgentBinary)" LogicalName="splat-agent" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\managed-deployment.ps1" LogicalName="managed-deployment.ps1" />
  </ItemGroup>

  <Target Name="RequireSplatAgentBinary" BeforeTargets="PrepareForBuild"
          Condition="'$(SplatAgentBinary)' != '' And !Exists('$(SplatAgentBinary)')">
    <Error Text="SplatAgentBinary is '$(SplatAgentBinary)', which does not exist. Publishing would ship an executable that cannot install its daemon." />
  </Target>

</Project>
