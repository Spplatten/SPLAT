<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        SPLAT's visual language is intentionally restrained: dark navy surfaces
        keep dense telemetry readable, while cyan/violet/green are reserved for
        action, intelligence, and healthy-control states. Keeping these values
        in theme dictionaries prevents individual screens from drifting.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SplatPageBackgroundBrush" Color="#0B1220" />
            <SolidColorBrush x:Key="SplatSurfaceBrush" Color="#111B2E" />
            <SolidColorBrush x:Key="SplatSurfaceElevatedBrush" Color="#17243A" />
            <SolidColorBrush x:Key="SplatSurfaceMutedBrush" Color="#0F192A" />
            <SolidColorBrush x:Key="SplatBorderBrush" Color="#263853" />
            <SolidColorBrush x:Key="SplatBorderStrongBrush" Color="#375271" />
            <SolidColorBrush x:Key="SplatTextPrimaryBrush" Color="#F4F7FB" />
            <SolidColorBrush x:Key="SplatTextSecondaryBrush" Color="#A9B7CA" />
            <SolidColorBrush x:Key="SplatTextTertiaryBrush" Color="#71839D" />
            <SolidColorBrush x:Key="SplatAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="SplatAccentStrongBrush" Color="#7AD8FF" />
            <SolidColorBrush x:Key="SplatAccentSubtleBrush" Color="#194CC2FF" />
            <SolidColorBrush x:Key="SplatAccentBorderBrush" Color="#8057C8F5" />
            <SolidColorBrush x:Key="SplatOnAccentBrush" Color="#03131E" />
            <SolidColorBrush x:Key="SplatVioletBrush" Color="#D29BFF" />
            <SolidColorBrush x:Key="SplatSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="SplatWarningBrush" Color="#FFB020" />
            <SolidColorBrush x:Key="SplatDangerBrush" Color="#FF6B7A" />
            <SolidColorBrush x:Key="SplatCodeSurfaceBrush" Color="#09111E" />
            <SolidColorBrush x:Key="SplatCodeTextBrush" Color="#C4E9FF" />
            <SolidColorBrush x:Key="SplatFocusBrush" Color="#8057C8F5" />
            <SolidColorBrush x:Key="SplatOverlayBrush" Color="#990B1220" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SplatPageBackgroundBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="SplatSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SplatSurfaceElevatedBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="SplatSurfaceMutedBrush" Color="#EAF0F7" />
            <SolidColorBrush x:Key="SplatBorderBrush" Color="#D5DFEA" />
            <SolidColorBrush x:Key="SplatBorderStrongBrush" Color="#A9BBD0" />
            <SolidColorBrush x:Key="SplatTextPrimaryBrush" Color="#182337" />
            <SolidColorBrush x:Key="SplatTextSecondaryBrush" Color="#526174" />
            <SolidColorBrush x:Key="SplatTextTertiaryBrush" Color="#718096" />
            <SolidColorBrush x:Key="SplatAccentBrush" Color="#087DAA" />
            <SolidColorBrush x:Key="SplatAccentStrongBrush" Color="#006184" />
            <SolidColorBrush x:Key="SplatAccentSubtleBrush" Color="#18087DAA" />
            <SolidColorBrush x:Key="SplatAccentBorderBrush" Color="#80087DAA" />
            <SolidColorBrush x:Key="SplatOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SplatVioletBrush" Color="#7142A5" />
            <SolidColorBrush x:Key="SplatSuccessBrush" Color="#2A7D27" />
            <SolidColorBrush x:Key="SplatWarningBrush" Color="#9A5F00" />
            <SolidColorBrush x:Key="SplatDangerBrush" Color="#B3263B" />
            <SolidColorBrush x:Key="SplatCodeSurfaceBrush" Color="#E8EEF5" />
            <SolidColorBrush x:Key="SplatCodeTextBrush" Color="#173149" />
            <SolidColorBrush x:Key="SplatFocusBrush" Color="#80087DAA" />
            <SolidColorBrush x:Key="SplatOverlayBrush" Color="#99F3F6FA" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="SplatCornerRadiusSmall">4</x:Double>
    <x:Double x:Key="SplatCornerRadiusMedium">8</x:Double>
    <x:Double x:Key="SplatCornerRadiusLarge">12</x:Double>
    <Thickness x:Key="SplatCardPadding">16</Thickness>
    <Thickness x:Key="SplatCompactCardPadding">12</Thickness>

    <Style x:Key="SplatPageStyle" TargetType="Page">
        <Setter Property="Background" Value="{ThemeResource SplatPageBackgroundBrush}" />
    </Style>

    <Style x:Key="SplatPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SplatPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SplatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SplatSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SplatCornerRadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource SplatCardPadding}" />
    </Style>

    <Style x:Key="SplatSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource SplatCardStyle}">
        <Setter Property="Background" Value="{ThemeResource SplatSurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SplatCornerRadiusSmall}" />
        <Setter Property="Padding" Value="{StaticResource SplatCompactCardPadding}" />
    </Style>

    <Style x:Key="SplatPageSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextTertiaryBrush}" />
    </Style>

    <Style x:Key="SplatMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextPrimaryBrush}" />
    </Style>

    <Style x:Key="SplatMetricUnitStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="SplatMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SplatTextSecondaryBrush}" />
    </Style>

    <Style x:Key="SplatCodeTextStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Code" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SplatCodeTextBrush}" />
        <Setter Property="Background" Value="{ThemeResource SplatCodeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="LuminousAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SplatAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SplatOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatAccentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SplatCornerRadiusSmall}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SplatSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SplatSurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SplatTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SplatCornerRadiusSmall}" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style x:Key="SplatStatusBarStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource SplatSurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SplatBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

</ResourceDictionary>
