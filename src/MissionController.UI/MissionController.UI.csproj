<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MissionController.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      The one project exempt from the warning gate in src/Directory.Build.props, because it is frozen:
      it stays on net9.0-windows and Windows App SDK 1.6, it ships nothing, and the warnings it would
      raise belong to the 2.x migration that is not being done today. Whoever does that migration owns
      this line, and deleting it is part of finishing.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by [LibraryImport]: the generated marshalling stubs are unsafe code (SYSLIB1062).
         This project's user32 declarations are source-generated, so the flag is not optional. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      MVVMTK0045: [ObservableProperty] on a field is not AOT-safe for WinRT. It fires 93 times here,
      once per observable field across the nine ViewModels, and it was the entire warning output of a
      cold solution build - drowning any real warning that might appear.

      Suppressed rather than migrated, deliberately. The fix is partial properties, and the MVVM
      Toolkit's generator emits no implementation for them under this project's language version:
      converting one ViewModel produced CS9248 ("must have an implementation part") on every property,
      including one with no initializer, and CS8050 on those with initializers. Both clear only under
      <LangVersion>preview</LangVersion>. Putting a security product on unreleased language features to
      silence an advisory warning is the worse trade.

      The warning describes a scenario this project does not use: there is no PublishAot, no
      PublishTrimmed, and no publish profile anywhere in the repository. UiWarningSuppressionTests
      binds this suppression to that fact and fails the build if AOT or trimming is ever switched on,
      so the day the scenario becomes real, this comment stops being true out loud instead of quietly.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <Import Project="Effects\Win2D\MissionController.Win2D.props" Condition="Exists('Effects\Win2D\MissionController.Win2D.props')" />

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.1.240916" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionController.Core\MissionController.Core.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Windows\MissionController.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Network\MissionController.Infrastructure.Network.csproj" />
    <ProjectReference Include="..\MissionController.Infrastructure.Data\MissionController.Infrastructure.Data.csproj" />
  </ItemGroup>

  <Import Project="Effects\Win2D\MissionController.Win2D.targets" Condition="Exists('Effects\Win2D\MissionController.Win2D.targets')" />
  <Import Project="Graphics\Shaders\MissionController.Direct3D.targets" Condition="Exists('Graphics\Shaders\MissionController.Direct3D.targets')" />

</Project>
