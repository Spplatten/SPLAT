<Page
    x:Class="MissionController.UI.Views.ProjectStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MissionController.Core.Models"
    xmlns:vm="using:MissionController.UI.ViewModels"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Project Studio" Style="{StaticResource SplatPageTitleStyle}" />
                <TextBlock Text="Compose finite, ordered agent playbooks with bounded evidence hand-off between stages" Style="{StaticResource SplatPageSubtitleStyle}" />
            </StackPanel>
            <ProgressRing Grid.Column="1" Style="{StaticResource CompactActivityRingStyle}" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="3">
                        <TextBlock Text="SAVED PROJECT PLAYBOOKS" Style="{StaticResource SplatPageSectionLabelStyle}" />
                        <TextBlock Text="Built-in plans are read-only. Save copies with the project-custom- prefix." FontSize="11" Foreground="{ThemeResource SplatTextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjectTemplate">
                                <StackPanel Padding="6,9" Spacing="3">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource SplatTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" />
                                    <TextBlock Text="{x:Bind StageSummary}" FontSize="10" Foreground="{ThemeResource SplatAccentBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Content="New Project Draft" Click="NewProject_Click" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- AI Workflow & Agent Synthesizer (n8n Alternative) -->
                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="14">
                            <StackPanel Spacing="8">
                                <!-- One wrapping block, not a horizontal StackPanel. A horizontal
                                     StackPanel measures its children with unbounded width, so the
                                     subtitle ran past the card and the operator read
                                     "(n8n Alternative / Zero-Trust" with the rest cut off. -->
                                <TextBlock Style="{StaticResource SplatPageSectionLabelStyle}" Foreground="{ThemeResource SplatAccentBrush}" TextWrapping="Wrap">
                                    <Run Text="⚡ NATURAL-LANGUAGE WORKFLOW SYNTHESIZER" />
                                    <Run Text="  (n8n Alternative / Zero-Trust Flow Builder)" FontSize="11" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="Describe your automation in plain English (e.g. 'Listen for TikTok OAuth callback and audit ad spend', or 'Scrape event logs for error spikes and alert SecOps'). SPLAT will compile it into sandboxed nodes." FontSize="11" Foreground="{ThemeResource SplatTextSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" PlaceholderText="e.g. Check DNS latency, then look for failed sign-ins, then summarize both..." Text="{x:Bind ViewModel.NaturalLanguagePrompt, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Synthesize Flow" Command="{x:Bind ViewModel.SynthesizeWorkflowCommand}" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <!-- These listed a webhook and an OAuth receiver on :5678 as live. Nothing in the app
                                     starts either listener; the roadmap defers trigger hosting. -->
                                <TextBlock Margin="0,4,0,0" Text="Webhook triggers and OAuth receivers are designed but not started by this app yet." FontSize="11" Foreground="{ThemeResource SplatTextTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PROJECT DEFINITION" Style="{StaticResource SplatPageSectionLabelStyle}" />
                        <!-- Three rows, declared. A Grid with no RowDefinitions has exactly one row,
                             so Grid.Row="1" and Grid.Row="2" below both resolved to row 0 and the
                             six fields were drawn on top of each other: "Description" over
                             "Project ID", the operator goal over the name. Nothing failed - WinUI
                             places a child in row 0 and says nothing - which is why XamlLayoutTests
                             now reads every grid in the project. -->
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Column="0" Header="Project ID" Text="{x:Bind ViewModel.ProjectId, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="Name" Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay}" />
                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Description" Text="{x:Bind ViewModel.ProjectDescription, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBox Grid.Row="2" Grid.Column="0" Header="Category" Text="{x:Bind ViewModel.ProjectCategory, Mode=TwoWay}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Header="Operator project goal (optional)" Text="{x:Bind ViewModel.ProjectGoal, Mode=TwoWay}" />
                        </Grid>

                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="12">
                            <StackPanel Spacing="9">
                                <TextBlock Text="ADD ORDERED AGENT STAGE" Style="{StaticResource SplatPageSectionLabelStyle}" />
                                <ComboBox Header="Governed agent" ItemsSource="{x:Bind ViewModel.AgentTemplates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAgentTemplate, Mode=TwoWay}" DisplayMemberPath="Name" />
                                <TextBox Header="Stage directive" Text="{x:Bind ViewModel.StageDirective, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" />
                                <CheckBox Content="Continue if this stage reports a failure" IsChecked="{x:Bind ViewModel.ContinueOnFailure, Mode=TwoWay}" />
                                <Button Content="Add Stage" Click="AddStage_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ORDERED STAGES" Style="{StaticResource SplatPageSectionLabelStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.DraftStages, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedStage, Mode=TwoWay}" SelectionMode="Single" MaxHeight="290">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectStageDraftItem">
                                    <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="10" Margin="0,0,0,6">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind StageLabel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind AgentTemplate.TargetModel}" FontSize="10" Foreground="{ThemeResource SplatVioletBrush}" />
                                            <TextBox Header="Directive" Text="{x:Bind Directive, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                                            <CheckBox Content="Continue on failure" IsChecked="{x:Bind ContinueOnFailure, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Remove Selected Stage" Click="RemoveStage_Click" HorizontalAlignment="Left" />

                        <TextBox Header="Deliverables (one per line)" Text="{x:Bind ViewModel.DeliverablesText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Save Project" Click="SaveProject_Click" Style="{StaticResource LuminousAccentButtonStyle}" />
                            <Button Content="Launch Project" Click="LaunchProject_Click" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SplatTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
