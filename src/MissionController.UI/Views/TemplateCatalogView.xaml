<Page
    x:Class="MissionController.UI.Views.TemplateCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MissionController.Core.Models"
    xmlns:vm="using:MissionController.UI.ViewModels"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="1:1:1 Governed Template Catalog" Style="{StaticResource SplatPageTitleStyle}" />
                <TextBlock Text="Enterprise diagnostics with guided operator input fields &amp; 1:1:1 strict sandbox isolation" Style="{StaticResource SplatPageSubtitleStyle}" />
                <Button Content="Build New Agent Template" HorizontalAlignment="Left" Margin="0,6,0,0" Click="CreateTemplate_Click" Style="{StaticResource LuminousAccentButtonStyle}" />
            </StackPanel>
            <ProgressRing
                Grid.Column="1"
                Style="{StaticResource CompactActivityRingStyle}"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <!-- The list gets the larger share: it is where the operator reads and chooses, and at
                 a fixed 380 px every name wrapped and every description was cut at two lines. The
                 inspector on the right only needs room for one template at a time. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="460" MaxWidth="760" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search + Template List -->
            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        Grid.Row="0"
                        PlaceholderText="Search by name, category, tool or id — every word must match"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="14" />

                    <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.CountSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.FilteredTemplates, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                        SelectionChanged="ListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SingleToolTemplate">
                                <Grid Padding="8,12" RowSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource SplatAccentSubtleBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Category}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                        <TextBlock Text="{x:Bind TargetModel}" FontSize="11" Foreground="{ThemeResource SplatVioletBrush}" />
                                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind Tool.Name}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Template Inspector & Dynamic Parameter Inputs -->
            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <!-- Template Title -->
                        <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Name, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Description, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <!-- Strict 1:1:1 Governance Badges -->
                        <Grid ColumnSpacing="12" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SplatSubtleCardStyle}" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 TARGET MODEL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.TargetModel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SplatVioletBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource SplatSubtleCardStyle}" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 DEDICATED TOOL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Tool.Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource SplatSubtleCardStyle}" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 EGRESS FQDN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.EgressRule.AllowedFqdn, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SplatSuccessBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Guided Operator Input Fields Section -->
                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource SplatAccentBrush}" />
                                    <TextBlock Text="OPERATOR MISSION PARAMETERS &amp; DIRECTIVES" FontWeight="Bold" FontSize="12" />
                                </StackPanel>

                                <!-- List of Dynamic Input Fields -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveParameters, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParameterInputItem">
                                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" />
                                                    <Border
                                                        Background="{ThemeResource SplatAccentSubtleBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Visibility="{x:Bind IsRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="REQUIRED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBox
                                                    Text="{x:Bind Value, Mode=TwoWay}"
                                                    AcceptsReturn="{x:Bind IsMultiLine}"
                                                    MinHeight="34"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- System Prompt Overview -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="GOVERNING SYSTEM PROMPT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="12">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.SystemPrompt, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Launch Button -->
                        <Button Content="Launch Governed Mission in Sandboxed Job Object" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="LaunchTemplate_Click" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
