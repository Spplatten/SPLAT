<Page
    x:Class="MissionController.UI.Views.TemplateCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MissionController.Core.Models"
    xmlns:vm="using:MissionController.UI.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="1:1:1 Governed Template Catalog" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Enterprise diagnostics with guided operator input fields &amp; 1:1:1 strict sandbox isolation" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ProgressRing
                Grid.Column="1"
                Style="{StaticResource CompactActivityRingStyle}"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Template List -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ListView
                    ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                    SelectionChanged="ListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SingleToolTemplate">
                            <Grid Padding="8,10" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <Border Background="#204CC2FF" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind Category}" FontSize="10" FontWeight="Bold" Foreground="#4CC2FF" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                    <TextBlock Text="{x:Bind TargetModel}" FontSize="10" Foreground="#D29BFF" />
                                    <TextBlock Text="•" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Tool.Name}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right: Template Inspector & Dynamic Parameter Inputs -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedTemplate, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <!-- Template Title -->
                        <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Name, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Description, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <!-- Strict 1:1:1 Governance Badges -->
                        <Grid ColumnSpacing="12" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 TARGET MODEL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.TargetModel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#D29BFF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 DEDICATED TOOL" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.Tool.Name, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#4CC2FF" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1 EGRESS FQDN" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.EgressRule.AllowedFqdn, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#6CCB5F" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Guided Operator Input Fields Section -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#4CC2FF" />
                                    <TextBlock Text="OPERATOR MISSION PARAMETERS &amp; DIRECTIVES" FontWeight="Bold" FontSize="12" />
                                </StackPanel>

                                <!-- List of Dynamic Input Fields -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveParameters, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ParameterInputItem">
                                            <StackPanel Spacing="6" Margin="0,0,0,12">
                                                <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBox
                                                    Text="{x:Bind Value, Mode=TwoWay}"
                                                    AcceptsReturn="{x:Bind IsMultiLine}"
                                                    MinHeight="34"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- System Prompt Overview -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="GOVERNING SYSTEM PROMPT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12">
                                <TextBlock Text="{x:Bind ViewModel.SelectedTemplate.SystemPrompt, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Launch Button -->
                        <Button Content="Launch Governed Mission in Sandboxed Job Object" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="LaunchTemplate_Click" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
