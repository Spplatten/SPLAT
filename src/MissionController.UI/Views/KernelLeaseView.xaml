<Page
    x:Class="MissionController.UI.Views.KernelLeaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Kernel Lease" Style="{StaticResource SplatPageTitleStyle}" />
            <TextBlock Text="The Rust daemon in WSL2 and its BPF-LSM program: the boundary the kernel holds under every Linux-lease template. Check this host, then mount or unmount the daemon from here." Style="{StaticResource SplatPageSubtitleStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Verdict & Actions -->
        <Border Grid.Row="1" Style="{StaticResource SplatCardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="SUBSTRATE VERDICT" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14" />
                        <TextBlock Text="{x:Bind ViewModel.Verdict, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="Read the plan before applying it. Each plan can be applied once. A guest managed by a service can be checked here; its administrator handles installation and removal." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="Check this host"
                        Style="{StaticResource SplatSecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CheckCommand}" />
                    <Button
                        Content="Plan mount"
                        Style="{StaticResource SplatSecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanManage, Mode=OneWay}"
                        Command="{x:Bind ViewModel.PlanMountCommand}" />
                    <Button
                        Content="Plan unmount"
                        Style="{StaticResource SplatSecondaryButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanManage, Mode=OneWay}"
                        Command="{x:Bind ViewModel.PlanUnmountCommand}" />
                    <Button
                        Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ApplyCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The report itself, whole -->
        <Border Grid.Row="2" Style="{StaticResource SplatCardStyle}" Padding="12">
            <TextBox
                Text="{x:Bind ViewModel.Report, Mode=OneWay}"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                FontFamily="Consolas"
                FontSize="12"
                PlaceholderText="Reports appear here. A plan lists every change before anything is made; a mount records each one, so an unmount can take out exactly those."
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Page>
