<Page
    x:Class="MissionController.UI.Views.LiveMissionMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Action Controls -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Live Mission Monitor" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Real-time subprocess telemetry streaming inside Win32 Job Object sandbox" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Style="{StaticResource CompactActivityRingStyle}"
                    IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    AutomationProperties.Name="Mission activity" />
                <Button Content="Abort Mission" Click="CancelButton_Click" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                <Button Content="Quick Run Netstat Audit" Style="{StaticResource LuminousAccentButtonStyle}" Click="QuickRunButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Live Resource Telemetry Gauges -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Card -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#4CC2FF" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- CPU Gauge Card -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="WIN32 JOB CPU USAGE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="%" FontSize="13" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- Memory Gauge Card -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="JOB WORKING SET RAM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.MemoryUsageBytes, Mode=OneWay}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Bytes" FontSize="13" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Jail Isolation Card -->
            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="NT ACL JAIL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Inheritance Severed" FontSize="14" FontWeight="Bold" Foreground="#6CCB5F" />
                    <TextBlock Text="Medium/Low Integrity Token" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live Streaming Dual Panes -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Sandboxed Tool Stdout -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="#4CC2FF" />
                        <TextBlock Text="SANDBOXED TOOL TELEMETRY (STDOUT/STDERR)" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox
                            Text="{x:Bind ViewModel.StdoutStream, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Consolas, Cascadia Code"
                            FontSize="12"
                            BorderThickness="0"
                            Background="Transparent" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Pane: AI Reasoning Streaming Engine -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="#D29BFF" />
                        <TextBlock Text="AI STREAMING DIAGNOSTIC SYNTHESIS (VERTEX AI / GEMINI)" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox
                            Text="{x:Bind ViewModel.AiAnalysisStream, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            BorderThickness="0"
                            Background="Transparent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
