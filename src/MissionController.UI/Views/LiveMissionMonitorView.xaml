<Page
    x:Class="MissionController.UI.Views.LiveMissionMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:effects="using:MissionController.UI.Effects"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Action Controls -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Live Mission Monitor" Style="{StaticResource SplatPageTitleStyle}" />
                <TextBlock Text="Real-time subprocess telemetry streaming inside Win32 Job Object sandbox" Style="{StaticResource SplatPageSubtitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Style="{StaticResource CompactActivityRingStyle}"
                    IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    AutomationProperties.Name="Mission activity" />
                <Button Content="Abort Mission" Click="CancelButton_Click" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" effects:ButtonPressShader.IsEnabled="True" />
                <Button Content="Quick Run Netstat Audit" Style="{StaticResource LuminousAccentButtonStyle}" Click="QuickRunButton_Click" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" effects:ButtonPressShader.IsEnabled="True" />
            </StackPanel>
        </Grid>

        <!-- Live Resource Telemetry Gauges -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status Card -->
            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="14" effects:BorderGlowShader.IsEnabled="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="STATUS" Style="{StaticResource SplatPageSectionLabelStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- CPU Gauge Card -->
            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="14" effects:BorderGlowShader.IsEnabled="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="WIN32 JOB CPU USAGE" Style="{StaticResource SplatPageSectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" Style="{StaticResource SplatMetricValueStyle}" />
                        <TextBlock Text="%" Style="{StaticResource SplatMetricUnitStyle}" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- Memory Gauge Card -->
            <Border Grid.Column="2" Style="{StaticResource SplatCardStyle}" Padding="14" effects:BorderGlowShader.IsEnabled="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="JOB WORKING SET RAM" Style="{StaticResource SplatPageSectionLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.MemoryUsageBytes, Mode=OneWay}" Style="{StaticResource SplatMetricValueStyle}" />
                        <TextBlock Text="Bytes" Style="{StaticResource SplatMetricUnitStyle}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Jail Isolation Card -->
            <Border Grid.Column="3" Style="{StaticResource SplatCardStyle}" Padding="14" effects:BorderGlowShader.IsEnabled="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="NT ACL JAIL" Style="{StaticResource SplatPageSectionLabelStyle}" />
                    <TextBlock Text="Inheritance Severed" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SplatSuccessBrush}" />
                    <TextBlock Text="Medium/Low Integrity Token" FontSize="11" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live Streaming Dual Panes -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Sandboxed Tool Stdout -->
            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="16" effects:BorderGlowShader.IsEnabled="True">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="#4CC2FF" />
                        <TextBlock Text="SANDBOXED TOOL TELEMETRY (STDOUT/STDERR)" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox
                            Text="{x:Bind ViewModel.StdoutStream, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Consolas, Cascadia Code"
                            Style="{StaticResource SplatCodeTextStyle}"
                            BorderThickness="0"
                            Background="Transparent" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Pane: AI Reasoning Streaming Engine -->
            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="16" effects:BorderGlowShader.IsEnabled="True">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE99A;" FontSize="14" Foreground="#D29BFF" />
                        <TextBlock Text="AI STREAMING DIAGNOSTIC SYNTHESIS" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Visibility="{x:Bind ViewModel.SimulatedBannerVisibility, Mode=OneWay}"
                            Background="#33FFB020" BorderBrush="#FFB020" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFB020" VerticalAlignment="Center" />
                            <TextBlock Text="LOCAL OFFLINE ENGINE — Running local heuristic rule evaluation. Add an API key in Settings for cloud LLM synthesis."
                                       FontSize="12" FontWeight="SemiBold" Foreground="#FFD98A" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBox
                            Text="{x:Bind ViewModel.AiAnalysisStream, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Foreground="{ThemeResource SplatTextPrimaryBrush}"
                            BorderThickness="0"
                            Background="Transparent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
