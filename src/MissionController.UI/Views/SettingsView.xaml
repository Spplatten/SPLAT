<Page
    x:Class="MissionController.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Enterprise Cloud Tenant &amp; DPAPI Settings" Style="{StaticResource SplatPageTitleStyle}" />
            <TextBlock Text="Manage AI provider API keys, OAuth 2.0 PKCE loopback, and Windows DPAPI credential storage" Style="{StaticResource SplatPageSubtitleStyle}" />
        </StackPanel>

        <!-- Settings Dual Column Hub (Non-scrollable, fits viewport) -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: DPAPI Credential Vault & Live Key Management -->
            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource SplatAccentBrush}" />
                        <TextBlock Text="Windows DPAPI Credential Vault" FontSize="15" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Secrets are encrypted at rest using Windows DPAPI (CurrentUser scope) with in-memory zeroing on dispose." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Live Key Entry & Verification -->
                    <Border Background="{ThemeResource SplatSurfaceMutedBrush}" BorderBrush="{StaticResource ElectricBorderGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CONNECT / UPDATE AI API KEY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox
                                    Grid.Column="0"
                                    PlaceholderText="Paste Anthropic (sk-ant-...) or Gemini (AIza...) key"
                                    Password="{x:Bind ViewModel.NewApiKeyInput, Mode=TwoWay}"
                                    PasswordChanged="PasswordBox_PasswordChanged"
                                    KeyDown="PasswordBox_KeyDown"
                                    Height="34" />
                                <Button
                                    Grid.Column="1"
                                    Content="Verify &amp; Save"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.IsSavingKey, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                                    Command="{x:Bind ViewModel.SaveAndValidateKeyCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSavingKey, Mode=OneWay}" Width="12" Height="12" />
                                <TextBlock Text="{x:Bind ViewModel.KeyValidationStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SplatAccentBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stored Secret Statuses -->
                    <StackPanel Spacing="6">
                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="8,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="Anthropic Claude API Key (Default AI Provider)" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AnthropicKeyStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SplatWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Remove"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete this key from the DPAPI vault"
                                    IsEnabled="{x:Bind ViewModel.HasAnthropicKey, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveStoredSecretCommand}"
                                    CommandParameter="{x:Bind ViewModel.AnthropicVaultKey}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="8,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="Google Gemini API Key" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.GeminiKeyStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SplatSuccessBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Remove"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete this key from the DPAPI vault"
                                    IsEnabled="{x:Bind ViewModel.HasGeminiKey, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveStoredSecretCommand}"
                                    CommandParameter="{x:Bind ViewModel.GeminiVaultKey}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Content="Refresh Vault Status" Click="RefreshVault_Click" HorizontalAlignment="Left" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Column 2: Enterprise Network SChannel & Identity Posture -->
            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE968;" FontSize="16" Foreground="{ThemeResource SplatSuccessBrush}" />
                        <TextBlock Text="Enterprise SChannel &amp; Zero-Trust Tokens" FontSize="15" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Active network configuration uses SocketsHttpHandler with Online CRL checking, Default Network Credentials, and automatic WPAD/PAC proxy discovery (Zscaler/Netskope MITM compatible)." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <!-- Stored Tokens -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="8,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="OAuth 2.0 PKCE Token" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.OAuthStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SplatAccentBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Remove"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete this token from the DPAPI vault"
                                    IsEnabled="{x:Bind ViewModel.HasOAuthToken, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveStoredSecretCommand}"
                                    CommandParameter="{x:Bind ViewModel.OAuthVaultKey}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="8,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="Service Account Token" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.SaStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SplatVioletBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Remove"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete this token from the DPAPI vault"
                                    IsEnabled="{x:Bind ViewModel.HasServiceAccountToken, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RemoveStoredSecretCommand}"
                                    CommandParameter="{x:Bind ViewModel.ServiceAccountVaultKey}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Token Lifecycle Proactive Refresh -->
                    <Border Background="{ThemeResource SplatSurfaceMutedBrush}" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.RenewalMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <Button Content="Force Token Refresh" Command="{x:Bind ViewModel.ForceTokenRefreshCommand}" FontSize="11" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
