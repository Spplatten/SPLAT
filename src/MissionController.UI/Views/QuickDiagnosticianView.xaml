<Page
    x:Class="MissionController.UI.Views.QuickDiagnosticianView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MissionController.UI.ViewModels"
    xmlns:models="using:MissionController.Core.Models"
    xmlns:effects="using:MissionController.UI.Effects"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="4,0,4,12">
        <!-- ========================================== -->
        <!-- STATE 1: AGENT SQUAD HUB (When HasResult == False) -->
        <!-- ========================================== -->
        <Grid RowSpacing="14" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Agent Squad Header Banner -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="{ThemeResource SplatAccentSubtleBrush}" CornerRadius="10">
                    <FontIcon Glyph="&#xE946;" FontSize="19" Foreground="{ThemeResource SplatAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Autonomous AI Agent Squad &amp; Fleet" Style="{StaticResource SplatPageTitleStyle}" />
                    <TextBlock Text="Dispatch governed sandboxed AI agents, author new agent templates, or compose a higher-level project playbook." Style="{StaticResource SplatPageSubtitleStyle}" />
                </StackPanel>
                <!-- Active Running Activity Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="True" Width="18" Height="18" Foreground="{ThemeResource SplatAccentBrush}" />
                    <TextBlock Text="Agent Reasoning &amp; Executing..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 8 Autonomous Agent Action Tiles (Compact 4x2 Grid) -->
            <GridView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="Tile_ItemClick"
                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                SelectionMode="None"
                HorizontalAlignment="Stretch">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendlyDiagnosticTile">
                        <Border
                            Width="230"
                            Height="112"
                            Style="{StaticResource SplatCardStyle}"
                            Padding="10,8"
                            Margin="0,0,8,8">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="7">
                                    <Border Style="{StaticResource SplatSubtleCardStyle}" Padding="4">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="14" Foreground="{x:Bind AccentColor}" />
                                    </Border>
                                    <StackPanel Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="Autonomous Agent" FontSize="8.5" Foreground="{x:Bind AccentColor}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="⚡" FontSize="10" Foreground="{ThemeResource SplatAccentBrush}" />
                                    <TextBlock Text="Dispatch Agent" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Custom Natural Language Agent Directive -->
            <!-- Border glow removed here: this panel wraps the hero Dispatch button, and a glowing
                 frame around it flattens the one element that is supposed to draw the eye. -->
            <Border Grid.Row="2" Background="{ThemeResource SplatSurfaceBrush}" BorderBrush="{StaticResource ElectricBorderGlowBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" />
                        <TextBlock Text="GIVE AN AGENT A CUSTOM DIRECTIVE:" FontWeight="Bold" FontSize="11" />
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="e.g., 'Audit Active Directory Kerberos tickets', 'Check cloud login speed', 'Find missing Windows patches'"
                            Text="{x:Bind ViewModel.CustomAskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="36"
                            VerticalAlignment="Center" />

                        <!-- Electric Energy Glowing Button with Lightning Glyph -->
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource ElectricEnergyButtonStyle}"
                            Command="{x:Bind ViewModel.RunCustomAskCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            VerticalAlignment="Center"
                            effects:AuroraEnergyShader.IsEnabled="True"
                            effects:ButtonPressShader.IsEnabled="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⚡" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="Dispatch Agent" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- STATE 2: DIAGNOSTIC & HEALING RESULTS (When HasResult == True) -->
        <!-- ========================================== -->
        <Grid RowSpacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Results Top Action Bar (with Reset / Back to Squad button) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SplatAccentSubtleBrush}" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{x:Bind ViewModel.ActiveDiagnosticTitle, Mode=OneWay}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SplatSurfaceElevatedBrush}" BorderBrush="{ThemeResource SplatBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="AGENT VERIFIED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SplatSuccessBrush}" />
                    </Border>
                </StackPanel>

                <!-- Reset / Back to Squad Action Button -->
                <Button
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ResetCommand}"
                    effects:ButtonPressShader.IsEnabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Back to Agent Squad" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Results Body: Split into Left Findings/Fixes and Right Telemetry -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Left Card: Executive Status, Findings & Self-Healing Actions -->
                <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Executive Headline -->
                        <Border Grid.Row="0" Style="{StaticResource SplatSubtleCardStyle}" Padding="12">
                            <TextBlock Text="{x:Bind ViewModel.ExecutiveStatusTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{x:Bind ViewModel.ExecutiveStatusColor, Mode=OneWay}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Plain English Findings -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="AGENT FINDINGS &amp; RECOMMENDATIONS:" FontWeight="Bold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ExecutiveFindings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Governed 1-Click Fixes -->
                        <Border Grid.Row="2" Background="{ThemeResource SplatSurfaceMutedBrush}" BorderBrush="{StaticResource ElectricBorderGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="{x:Bind ViewModel.AvailableFixes.Count, Mode=OneWay, Converter={StaticResource PositiveNumberToVisibilityConverter}}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⚡" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SplatAccentBrush}" />
                                    <TextBlock Text="GOVERNED 1-CLICK ACTIONS:" FontWeight="Bold" FontSize="11" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableFixes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RemediationAction">
                                            <Border Style="{StaticResource SplatCardStyle}" Padding="10" Margin="0,0,0,6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SplatAccentBrush}" />
                                                        <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button
                                                            Style="{StaticResource ElectricEnergyButtonStyle}"
                                                            Click="ApplyFixButton_Click"
                                                            Tag="{x:Bind}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="⚡" FontSize="11" FontWeight="Bold" />
                                                                <TextBlock Text="Apply Fix" FontSize="11" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Content="↩️"
                                                            FontSize="11"
                                                            Visibility="{x:Bind CanRollback, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Click="ApplyRollbackButton_Click"
                                                            Tag="{x:Bind}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{x:Bind ViewModel.RemediationStatusMessage, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Card: Raw Sandboxed Subprocess Telemetry Log -->
                <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="14">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="#4CC2FF" />
                            <TextBlock Text="SANDBOXED TOOL &amp; AI TELEMETRY" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                Text="{x:Bind ViewModel.TechnicalRawLog, Mode=OneWay}"
                                IsReadOnly="True"
                                FontFamily="Consolas, Cascadia Code"
                                FontSize="10.5"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
