<Page
    x:Class="MissionController.UI.Views.QuickDiagnosticianView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MissionController.UI.ViewModels"
    xmlns:models="using:MissionController.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="18" Padding="8,0,8,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Agent Squad Header Banner -->
            <StackPanel Grid.Row="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="#00E5FF" />
                    <TextBlock Text="SPLAT Autonomous AI Agent Squad &amp; Self-Healing Fleet" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="Dispatch 8 dedicated, sandboxed AI agents with 1 click, or give them a custom directive." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 8 Autonomous Agent Action Tiles -->
            <GridView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="Tile_ItemClick"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FriendlyDiagnosticTile">
                        <Border
                            Width="260"
                            Height="135"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,0,12,12">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="{x:Bind AccentColor}" />
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="Autonomous Agent" FontSize="9" Foreground="{x:Bind AccentColor}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#00E5FF" />
                                    <TextBlock Text="Dispatch Agent Now" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Custom Natural Language Agent Directive -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{StaticResource ElectricBorderGlowBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" />
                        <TextBlock Text="GIVE AN AGENT A CUSTOM DIRECTIVE:" FontWeight="Bold" FontSize="12" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="e.g., 'Audit Active Directory Kerberos tickets', 'Check cloud login speed', 'Find missing Windows patches'"
                            Text="{x:Bind ViewModel.CustomAskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="38"
                            VerticalAlignment="Center" />

                        <!-- Electric Energy Glowing Button with Lightning Glyph -->
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource ElectricEnergyButtonStyle}"
                            Command="{x:Bind ViewModel.RunCustomAskCommand}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⚡" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="Dispatch Agent" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Executive Summary & Governed Remediation Results Card -->
            <StackPanel Grid.Row="3" Spacing="14">
                <!-- Progress indicator while running -->
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <ProgressRing IsActive="True" Width="20" Height="20" Foreground="#00E5FF" />
                    <TextBlock Text="Autonomous Agent reasoning &amp; executing sandboxed diagnostics in Windows Job Object..." FontWeight="SemiBold" FontSize="13" Foreground="#00E5FF" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Results Box -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Spacing="16">
                        <!-- Executive Status Header -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.ActiveDiagnosticTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ExecutiveStatusTitle, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="{x:Bind ViewModel.ExecutiveStatusColor, Mode=OneWay}" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#206CCB5F" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="AGENT VERIFIED" FontSize="11" FontWeight="Bold" Foreground="#6CCB5F" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Plain English Bullet Points for Aunt Mary -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="AGENT FINDINGS &amp; RECOMMENDATIONS:" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ExecutiveFindings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontSize="13" Margin="0,2,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Layer 8: Governed 1-Click Self-Healing Fix Cards -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{StaticResource ElectricBorderGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="{x:Bind ViewModel.AvailableFixes.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚡" FontSize="16" FontWeight="Bold" Foreground="#00E5FF" />
                                    <TextBlock Text="GOVERNED 1-CLICK SELF-HEALING ACTIONS:" FontWeight="Bold" FontSize="12" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableFixes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:RemediationAction">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="13" Foreground="#00E5FF" />
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button
                                                            Style="{StaticResource ElectricEnergyButtonStyle}"
                                                            Command="{Binding DataContext.ApplyFixCommand, ElementName=ContentFrame}"
                                                            CommandParameter="{x:Bind}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="⚡" FontSize="12" FontWeight="Bold" />
                                                                <TextBlock Text="Apply 1-Click Fix" FontSize="11" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            Content="↩️ Rollback"
                                                            FontSize="11"
                                                            Visibility="{x:Bind CanRollback, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                                                            Command="{Binding DataContext.ApplyRollbackCommand, ElementName=ContentFrame}"
                                                            CommandParameter="{x:Bind}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Status of Fix Execution -->
                                <TextBlock Text="{x:Bind ViewModel.RemediationStatusMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#4CC2FF" />
                            </StackPanel>
                        </Border>

                        <!-- Expandable Advanced Technical Telemetry -->
                        <Expander Header="Show Raw Sandboxed Tool Telemetry (For IT / SecOps)" HorizontalAlignment="Stretch">
                            <TextBox
                                Text="{x:Bind ViewModel.TechnicalRawLog, Mode=OneWay}"
                                IsReadOnly="True"
                                FontFamily="Consolas"
                                FontSize="11"
                                TextWrapping="Wrap"
                                MinHeight="160"
                                Margin="0,8,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
