<Page
    x:Class="MissionController.UI.Views.SecurityAuditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MissionController.Core.Models"
    Style="{StaticResource SplatPageStyle}"
    mc:Ignorable="d">

    <Grid RowSpacing="10" Padding="4,0,4,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Cryptographic Security Audit &amp; Compliance Center" Style="{StaticResource SplatPageTitleStyle}" />
                <TextBlock Text="SHA-256 Chained Hash Ledger, Merkle Tree Proofs, SIEM Ingestion, and EDR Telemetry Bridge" Style="{StaticResource SplatPageSubtitleStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Refresh All" Click="RefreshButton_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                <Button Content="Verify Chain &amp; Merkle Root" Style="{StaticResource LuminousAccentButtonStyle}" Click="VerifyButton_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
            </StackPanel>
        </Grid>

        <!-- Cryptographic Posture & Emergency Control Hub (Dual Column) -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Cryptographic Non-Repudiation & Circuit Breaker -->
            <Border Grid.Column="0" Style="{StaticResource SplatCardStyle}" Padding="12">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9A6;" FontSize="14" Foreground="{ThemeResource SplatSuccessBrush}" />
                            <TextBlock Text="CRYPTOGRAPHIC NON-REPUDIATION" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MerkleVerificationStatus, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SplatSuccessBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.IntegrityStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <!-- Emergency Circuit Breaker Inline -->
                    <Border Background="{ThemeResource SplatSurfaceBrush}" BorderBrush="{ThemeResource SplatDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="Operator ID / Token Fingerprint" Text="{x:Bind ViewModel.RevocationTarget, Mode=TwoWay}" FontSize="10" Height="30" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="TRIP BREAKER" Background="{ThemeResource SplatDangerBrush}" Foreground="White" FontWeight="Bold" FontSize="10" Height="30" Click="TripCircuitBreaker_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Column 1: Zero-Trust Token Health & EDR Posture -->
            <Border Grid.Column="1" Style="{StaticResource SplatCardStyle}" Padding="12">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEC19;" FontSize="14" Foreground="{ThemeResource SplatAccentBrush}" />
                            <TextBlock Text="EDR POSTURE &amp; TOKEN HEALTH" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Renew Tokens" FontSize="10" Padding="6,2" Click="ProactiveRenew_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.OAuthTokenTtlStatus, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SaTokenTtlStatus, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Test Sentinel" FontSize="10" Padding="6,2" Click="TestSentinel_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                        <Button Content="Test Syslog" FontSize="10" Padding="6,2" Click="TestSyslog_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.SiemStatusMessage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Compliance Package Exporter Bar -->
        <Border Grid.Row="2" Style="{StaticResource SplatCardStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SplatVioletBrush}" />
                        <TextBlock Text="EXPORT COMPLIANCE AUDIT EVIDENCE (MERKLE PROOFS + OFFLINE SCRIPT)" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SplatVioletBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ComplianceExportStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Export SOC 2" FontSize="11" Click="ExportSoc2_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                    <Button Content="Export HIPAA" FontSize="11" Click="ExportHipaa_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                    <Button Content="Export CMMC 2" FontSize="11" Style="{StaticResource LuminousAccentButtonStyle}" Click="ExportCmmc_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- One mission's run record -->
        <Border Grid.Row="3" Background="{ThemeResource SplatSurfaceBrush}" BorderBrush="{ThemeResource SplatLineBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource SplatVioletBrush}" />
                        <TextBlock Text="EXPORT ONE MISSION'S RUN RECORD" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SplatVioletBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.RunRecordStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBox Width="260" FontSize="11" PlaceholderText="Mission id (newest, if left blank)" Text="{x:Bind ViewModel.RunRecordMissionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Export run record" FontSize="11" Click="ExportRunRecord_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Audit Table -->
        <Border Grid.Row="4" Style="{StaticResource SplatCardStyle}" Padding="10">
            <ListView ItemsSource="{x:Bind ViewModel.AuditLogs, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AuditLogEntry">
                        <Grid Padding="6,8" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#20D29BFF" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="{x:Bind Action}" FontSize="10" FontWeight="Bold" Foreground="#D29BFF" />
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                    <TextBlock Text="Mission:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind MissionId}" FontSize="10" FontFamily="Consolas" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind TimestampUtc}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{x:Bind Details}" FontSize="11" TextWrapping="Wrap" Margin="0,2" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PrevHash:" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind PreviousHash}" FontSize="9" FontFamily="Consolas" MaxLines="1" Width="120" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="EntryHash:" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind EntryHash}" FontSize="9" FontFamily="Consolas" Foreground="{ThemeResource SplatSuccessBrush}" MaxLines="1" Width="120" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Operator:" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind OperatorIdentity}" FontSize="9" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
