<Window
    x:Class="MissionController.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Mission Controller - AI-Native IT &amp; SysOps Appliance"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom App TitleBar -->
        <Grid Grid.Row="0" Height="40" Padding="16,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE756;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                <TextBlock Text="MISSION CONTROLLER" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                <Border Background="#20808080" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="HARDENED ENTERPRISE" FontSize="10" FontWeight="SemiBold" Foreground="#4CC2FF" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged"
            IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="AI Agent Squad (1-Click)" Tag="QuickSolve" Icon="Emoji2" IsSelected="True" />
                <NavigationViewItem Content="Agent Setup &amp; Readiness" Tag="Onboarding" Icon="Help" />
                <NavigationViewItem Content="Live Agent Mission Monitor" Tag="Monitor" Icon="Play" />
                <NavigationViewItem Content="Governed Agent Fleet Catalog" Tag="Catalog" Icon="BrowsePhotos" />
                <NavigationViewItem Content="Agent Cryptographic Audit" Tag="Audit" Icon="Permissions" />
                <NavigationViewItem Content="Agent Semantic Memory" Tag="Memory" Icon="Find" />
                <NavigationViewItem Content="Kernel Sandbox &amp; Jail Inspector" Tag="Jail" Icon="Folder" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="16">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Bottom Governance Status Bar -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBlock Text="● Sandbox: Win32 Job Object (Strict Hard Caps)" FontSize="11" Foreground="#6CCB5F" />
                <TextBlock Text="● NT ACL Jails: Parent Inheritance Stripped" FontSize="11" Foreground="#4CC2FF" />
                <TextBlock Text="● Ledger: SHA-256 Chained WAL" FontSize="11" Foreground="#D29BFF" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Governed 1:1:1 Appliance | .NET 9 LTS" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
