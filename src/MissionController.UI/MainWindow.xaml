<Window
    x:Class="MissionController.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:effects="using:MissionController.UI.Effects"
    Title="SPLAT — Autonomous AI Agent Fleet &amp; System Appliance"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SplatPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The ambient layer is hosted by an empty visual so it cannot tint
             text, intercept input, or change the XAML accessibility tree. -->
        <Grid
            Grid.RowSpan="3"
            IsHitTestVisible="False"
            effects:AmbientSurfaceShader.IsEnabled="True" />

        <!-- Custom App TitleBar -->
        <Grid
            Grid.Row="0"
            Height="48"
            Padding="18,0"
            Background="{ThemeResource SplatSurfaceMutedBrush}"
            BorderBrush="{ThemeResource SplatBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- The real mark, not the Segoe glyph that stood in for it. Emblem only: the
                     lockup's wordmark is white artwork and would vanish in the light theme. -->
                <Image Source="ms-appx:///Assets/splat-emblem.png" Width="28" Height="28"
                       Stretch="Uniform" AutomationProperties.Name="SPLAT" />
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="SPLAT" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SplatTextPrimaryBrush}" />
                    <TextBlock Text="MISSION CONTROL" FontSize="9" CharacterSpacing="120" Foreground="{ThemeResource SplatTextTertiaryBrush}" />
                </StackPanel>
                <Border Background="{ThemeResource SplatSurfaceElevatedBrush}" BorderBrush="{ThemeResource SplatBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="6,0,0,0">
                    <TextBlock Text="HARDENED ENTERPRISE" FontSize="9" CharacterSpacing="45" FontWeight="SemiBold" Foreground="{ThemeResource SplatAccentBrush}" />
                </Border>
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource SplatSurfaceElevatedBrush}" BorderBrush="{ThemeResource SplatBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse x:Name="SelfCheckDot" Width="6" Height="6" Fill="{ThemeResource SplatTextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SelfCheckLabel" Text="SELF-CHECK RUNNING" FontSize="9" CharacterSpacing="40" FontWeight="SemiBold" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="244"
            CompactPaneLength="56"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged"
            IsSettingsVisible="True">
            <NavigationView.PaneHeader>
                <TextBlock Text="OPERATIONS" Style="{StaticResource SplatPageSectionLabelStyle}" Margin="12,10,0,8" CharacterSpacing="80" />
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Agent Fleet" Tag="QuickSolve" Icon="Emoji2" IsSelected="True" />
                <NavigationViewItem Content="Setup &amp; Readiness" Tag="Onboarding" Icon="Help" />
                <NavigationViewItem Content="Live Missions" Tag="Monitor" Icon="Play" />
                <NavigationViewItem Content="Fleet Catalog" Tag="Catalog" Icon="BrowsePhotos" />
                <!-- Icon="..." resolves against the Symbol enum, which has no "TaskView" member, so
                     the string form threw at XAML load. The glyph is addressed directly instead. -->
                <NavigationViewItem Content="Project Studio" Tag="Projects">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cryptographic Audit" Tag="Audit" Icon="Permissions" />
                <NavigationViewItem Content="Semantic Memory" Tag="Memory" Icon="Find" />
                <NavigationViewItem Content="Sandbox Inspector" Tag="Jail" Icon="Folder" />
                <!-- The Linux side of the sandbox: the daemon and its BPF-LSM program, checked, mounted and
                     unmounted by the same code splat-mcp runs. Shield glyph, addressed directly as above. -->
                <NavigationViewItem Content="Kernel Lease" Tag="Lease">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="20,18,20,22">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <SlideNavigationTransitionInfo Effect="FromRight" />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Bottom Governance Status Bar -->
        <Grid Grid.Row="2" Style="{StaticResource SplatStatusBarStyle}" Padding="18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="JobSandboxDot" Width="6" Height="6" Fill="{ThemeResource SplatTextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="JobSandboxLabel" Text="CHECKING JOB SANDBOX" FontSize="10" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="JailDot" Width="6" Height="6" Fill="{ThemeResource SplatTextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="JailLabel" Text="CHECKING ACL JAIL" FontSize="10" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="LedgerDot" Width="6" Height="6" Fill="{ThemeResource SplatTextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LedgerLabel" Text="CHECKING LEDGER" FontSize="10" Foreground="{ThemeResource SplatTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="RuntimeLabel" Grid.Column="1" FontSize="10" CharacterSpacing="35" Foreground="{ThemeResource SplatTextTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
