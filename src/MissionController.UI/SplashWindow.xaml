<Window
    x:Class="MissionController.UI.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SPLAT"
    mc:Ignorable="d">

    <!-- No plate: the marks are keyed to transparency and the window is composed with per-pixel
         alpha (see SplashWindow.xaml.cs), so what sits behind this window is what shows through.
         Transparent rather than unset - an unset Background is not hit-testable, and a window the
         mouse falls through is a window the desktop below it can be clicked through. -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image
            Grid.Row="0"
            Source="ms-appx:///Assets/splat-lockup-onglass.png"
            Height="204"
            Margin="0,26,0,0"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Stretch="Uniform"
            AutomationProperties.Name="SPLAT — Software Infrastructure" />

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,18" HorizontalAlignment="Center">
            <ProgressBar
                Width="196"
                Height="2"
                IsIndeterminate="True"
                Foreground="{ThemeResource SplatAccentBrush}"
                Background="#64758E" />
            <TextBlock
                Text="STARTING MISSION CONTROL"
                FontSize="9"
                CharacterSpacing="120"
                HorizontalAlignment="Center"
                Foreground="#8093AC" />

            <!-- The enterprise mark, emblem and strapline only: its own SPLAT wordmark would be the
                 second one on this plate. The eBPF guard it names is proven in isolation and not yet
                 on the mission path (docs/SPLAT-Field-Guide.html, Part 7) - this is the product line,
                 not a claim about what the console enforces today. -->
            <!-- Mid slate everywhere below the mark, not the plate's own dark tones: with the window
                 transparent these sit on the operator's desktop, and a colour picked for #070B14
                 disappears the moment that desktop is light. -->
            <Border Height="1" Width="240" Background="#64758E" Margin="0,4,0,2" />
            <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                <Image
                    Source="ms-appx:///Assets/splat-enterprise-emblem-onglass.png"
                    Height="35"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="SPLAT Enterprise" />
                <TextBlock
                    Text="ENTERPRISE eBPF SECURITY"
                    FontSize="9"
                    FontWeight="SemiBold"
                    CharacterSpacing="140"
                    VerticalAlignment="Center"
                    Foreground="#7A8CA5" />
            </StackPanel>

            <TextBlock
                Text="© PLATTEN INDUSTRIES 2026"
                FontSize="8"
                CharacterSpacing="80"
                HorizontalAlignment="Center"
                Foreground="#6E8098" />
        </StackPanel>
    </Grid>
</Window>
