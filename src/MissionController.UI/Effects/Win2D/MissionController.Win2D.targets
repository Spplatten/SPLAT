<Project>
  <PropertyGroup>
    <Win2DShaderSource>$(MSBuildThisFileDirectory)MissionControllerGlow.hlsl</Win2DShaderSource>
    <!-- fxc emits CSO bytes; Win2D's PixelShaderEffect convention is .bin. -->
    <Win2DShaderBytecode>$(IntermediateOutputPath)Win2DShaders\MissionControllerGlow.bin</Win2DShaderBytecode>
    <Win2DShaderCompileScript>$(MSBuildThisFileDirectory)Compile-Win2DShader.ps1</Win2DShaderCompileScript>
    <Win2DFxcPath Condition="'$(Win2DFxcPath)' == ''"></Win2DFxcPath>
    <Win2DShaderIncludePath Condition="'$(Win2DShaderIncludePath)' == ''"></Win2DShaderIncludePath>
    <Win2DShaderRuntimePath>Effects\Win2D\MissionControllerGlow.bin</Win2DShaderRuntimePath>
    <Win2DShaderRuntimeDirectory>$(OutDir)Effects\Win2D</Win2DShaderRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableMissionControllerWin2DShaderBuild)' == 'true'">
    <None Update="$(Win2DShaderSource)" />
    <Content Include="$(Win2DShaderBytecode)" CopyToOutputDirectory="PreserveNewest" Link="$(Win2DShaderRuntimePath)" />
  </ItemGroup>

  <Target
    Name="CompileMissionControllerWin2DShader"
    BeforeTargets="PrepareForBuild"
    Condition="'$(EnableMissionControllerWin2DShaderBuild)' == 'true'">
    <MakeDir Directories="$(IntermediateOutputPath)Win2DShaders" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(Win2DShaderCompileScript)&quot; -Source &quot;$(Win2DShaderSource)&quot; -Output &quot;$(Win2DShaderBytecode)&quot; -FxcPath &quot;$(Win2DFxcPath)&quot; -IncludePath &quot;$(Win2DShaderIncludePath)&quot;" />
    <MakeDir Directories="$(Win2DShaderRuntimeDirectory)" />
    <Copy SourceFiles="$(Win2DShaderBytecode)" DestinationFiles="$(OutDir)$(Win2DShaderRuntimePath)" />
  </Target>
</Project>
