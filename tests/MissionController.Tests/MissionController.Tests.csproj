<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Required by [LibraryImport]: the generated marshalling stubs are unsafe code (SYSLIB1062).
         Matches MissionController.Infrastructure.Windows, whose interop surface this suite covers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Enumerated at test time, so a case is added by dropping a file in. Copied rather than
         embedded so the corpus stays readable as the telemetry it imitates. -->
    <Content Include="Corpus\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MissionController.Core\MissionController.Core.csproj" />
    <ProjectReference Include="..\..\src\MissionController.Infrastructure.Windows\MissionController.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\..\src\MissionController.Infrastructure.Network\MissionController.Infrastructure.Network.csproj" />
    <ProjectReference Include="..\..\src\MissionController.Infrastructure.Data\MissionController.Infrastructure.Data.csproj" />
    <ProjectReference Include="..\..\src\MissionController.Infrastructure.Linux\MissionController.Infrastructure.Linux.csproj" />
    <ProjectReference Include="..\..\src\splat-mcp\splat-mcp.csproj" />
  </ItemGroup>

</Project>
