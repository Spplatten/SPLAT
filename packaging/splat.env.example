# SPLAT configuration - read by run.bat before the console starts.
#
# One KEY=VALUE per line. Lines starting with # are ignored. Every line is optional:
# an empty file means "all defaults", and the defaults are right for most workstations.
#
# This file is copied to %LOCALAPPDATA%\SPLAT\splat.env on first run and edited THERE.
# Changes take effect the next time SPLAT is started through run.bat.
#
# API keys (Anthropic, Gemini) do NOT go in this file. Paste them into the Settings
# pane inside SPLAT; they are stored encrypted for your Windows account (DPAPI).

# Where the audit ledger and mission database live.
# Default: %LOCALAPPDATA%\MissionController\Data\missioncontroller.db
# Point this at a folder that is backed up if the audit chain matters to you.
#SPLAT_DB_PATH=D:\SPLAT\missioncontroller.db

# HMAC-SHA256 key file (32 random bytes or more) for the audit ledger chain. Without it the ledger is
# still chained and verified, but not keyed. If set, the file must exist or SPLAT refuses to start.
#SPLAT_LEDGER_KEY_FILE=D:\SPLAT\keys\ledger.key

# RSA private key (PEM, 2048 bits or more) that signs exported mission run records. Without it exports
# still work and say they are unsigned. If set, the file must exist or SPLAT refuses to start.
#SPLAT_RUN_RECORD_KEY_FILE=D:\SPLAT\keys\run-record.key
